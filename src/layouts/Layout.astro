---
import '../styles/globals.css';
import { SERVICES, CONTACT_INFO, servicePath, type ServiceItem } from '@/data/services';

interface Props {
  title?: string;
  description?: string;
  service?: ServiceItem;
  noindex?: boolean;
}

const {
  title = 'Firma de abogados en Bogotá | Torres & Torres Abogados Asociados',
  description = 'Firma de abogados en Bogotá D.C. Asesoría en derecho societario, empresarial, laboral, litigios y protección patrimonial. Conozca las áreas de práctica de Torres & Torres.',
  service,
  noindex = false,
} = Astro.props;

const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site);
const organizationId = new URL('/#organization', site).href;

const organization = {
  '@type': 'LegalService',
  '@id': organizationId,
  name: CONTACT_INFO.firmName,
  legalName: 'TORRES & TORRES Abogados Asociados S.A.S.',
  url: site.href,
  telephone: CONTACT_INFO.mobile,
  email: CONTACT_INFO.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT_INFO.address,
    addressLocality: 'Bogotá D.C.',
    addressCountry: 'CO',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios jurídicos',
    itemListElement: SERVICES.map((item) => ({
      '@type': 'Offer',
      itemOffered: { '@id': new URL(servicePath(item) + '#service', site).href },
    })),
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    ...(service ? [service] : SERVICES).map((item) => ({
      '@type': 'Service',
      '@id': new URL(servicePath(item) + '#service', site).href,
      url: new URL(servicePath(item), site).href,
      name: item.title,
      description: item.shortDescription,
      serviceType: item.pillarTitle,
      provider: { '@id': organizationId },
    })),
  ],
};
---

<!doctype html>
<html lang="es-CO" class="scroll-smooth antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#081225" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="TORRES & TORRES Abogados Asociados" />
    <meta name="creator" content="TORRES & TORRES Abogados Asociados" />
    <meta name="publisher" content="TORRES & TORRES Abogados Asociados" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TORRES & TORRES Abogados Asociados" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Structured Data JSON-LD -->
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <!-- Google Analytics (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y64B1HGD7H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-Y64B1HGD7H');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "z5hpqh0qsz");
    </script>
  </head>
  <body class="bg-[#081225] text-primary-light min-h-screen selection:bg-accent-gold selection:text-primary-dark font-sans relative">
    <slot />
  </body>
</html>
